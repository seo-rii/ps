+	ANY_DIGIT_HAS_BEEN_PRINTED_FLAG no_thousands
+one_thousand:
+	// WAITING_FOR_FIRST_NUMBER_FLAG is no longer needed for input;
+	// toggle it to remember that a leading 1 must be forced after addition.
+	WAITING_FOR_FIRST_NUMBER_FLAG one_thousand_marked
+one_thousand_marked:
+	R_SUBROUTINE_FLAG3
+	MOVED clear_tmp2
+
+no_thousands:
+	// The branch above changed ANY... from MovD to Nop; restore it for output.
+	ANY_DIGIT_HAS_BEEN_PRINTED_FLAG no_thousands_restored
+no_thousands_restored:
 	R_SUBROUTINE_FLAG3
 	MOVED clear_tmp2
 
