--- /mnt/data/example_adder_original.hell	2026-08-23 09:38:14.498143555 +0000
+++ /mnt/data/adder_0_to_1000_nocounter.hell	2026-08-23 09:41:00.458583132 +0000
@@ -549,7 +549,28 @@
 	NUMBER_READ_FLAG restore_initial_state
 
 read_second_number:
-	// ADD NUMBERS AND PRINT RESULT
+	// PRINT_ZERO_FLAG is untouched during input.  If both operands were
+	// 1000, n2_fourth_digit advanced it once from MovD to Nop.
+	PRINT_ZERO_FLAG not_both_thousands
+both_thousands:
+	ROT '2'<<1 R_ROT OUT ?- R_OUT
+	R_ANY_DIGIT_HAS_BEEN_PRINTED_FLAG
+	MOVED print_result
+
+not_both_thousands:
+	// ANY_DIGIT_HAS_BEEN_PRINTED_FLAG is toggled for every operand that
+	// was 1000, so Nop means exactly one and MovD means zero here.
+	ANY_DIGIT_HAS_BEEN_PRINTED_FLAG no_thousands
+one_thousand:
+	WAITING_FOR_FIRST_NUMBER_FLAG one_thousand_marked
+one_thousand_marked:
+	R_SUBROUTINE_FLAG3
+	MOVED clear_tmp2
+
+no_thousands:
+	// Restore ANY... from Nop to MovD for the ordinary output routine.
+	ANY_DIGIT_HAS_BEEN_PRINTED_FLAG no_thousands_restored
+no_thousands_restored:
 	R_SUBROUTINE_FLAG3
 	MOVED clear_tmp2
 
@@ -563,9 +584,29 @@
 // shift digit...
 append_tmp_digit_to_first_number:
 	R_WAITING_FOR_FIRST_NUMBER_FLAG
+	// Before a valid fourth digit (only possible for 1000), the hundreds
+	// digit is 1, whose LOW cycle is MovD.  The MSD is cleared immediately
+	// afterwards anyway, so probing this destructive state costs no storage.
+	N1_DIGIT2_LOW n1_fourth_digit
+	MOVED clear_n1_msd
+
+n1_fourth_digit:
+	// Mark operand 1 == 1000 by toggling ANY... from MovD to Nop.
+	ANY_DIGIT_HAS_BEEN_PRINTED_FLAG n1_fourth_marked
+n1_fourth_marked:
 	MOVED clear_n1_msd
 
 append_tmp_digit_to_second_number:
+	N2_DIGIT2_LOW n2_fourth_digit
+	MOVED clear_n2_msd
+
+n2_fourth_digit:
+	// Toggling ANY... gives parity of the number of 1000 operands.
+	// If operand 1 was also 1000, mark the two-thousand case in PRINT_ZERO.
+	ANY_DIGIT_HAS_BEEN_PRINTED_FLAG n2_only_second
+	PRINT_ZERO_FLAG n2_fourth_done
+n2_only_second:
+n2_fourth_done:
 	MOVED clear_n2_msd
 
 
@@ -710,6 +751,9 @@
 
 add_n2_digit2_to_n1_digit2_fin:
 	R_OVERFLOW
+	WAITING_FOR_FIRST_NUMBER_FLAG print_leading_one
+	WAITING_FOR_FIRST_NUMBER_FLAG check_normal_overflow
+check_normal_overflow:
 	OVERFLOW print_leading_one
 	MOVED print_result
 
