--- /mnt/data/example_adder_original.hell	2026-08-23 09:38:14.498143555 +0000
+++ /mnt/data/adder_0_to_1000_min.hell	2026-08-23 09:53:01.768097739 +0000
@@ -563,9 +563,37 @@
 // shift digit...
 append_tmp_digit_to_first_number:
 	R_WAITING_FOR_FIRST_NUMBER_FLAG
+	// With valid inputs in [0,1000], a fourth digit can only occur for
+	// 1000.  Immediately before that digit is shifted in, DIGIT2 is 1.
+	// Its LOW half is therefore MovD, while it is zero before every
+	// digit of a <=999 input.  Probe it just before clear_n1_msd.
+	N1_DIGIT2_LOW n1_is_1000
+	MOVED clear_n1_msd
+
+n1_is_1000:
+	// ANY... is untouched during input. Toggle it once to remember
+	// that exactly one operand seen so far is 1000.
+	ANY_DIGIT_HAS_BEEN_PRINTED_FLAG n1_1000_marked
+n1_1000_marked:
 	MOVED clear_n1_msd
 
 append_tmp_digit_to_second_number:
+	N2_DIGIT2_LOW n2_is_1000
+	MOVED clear_n2_msd
+
+n2_is_1000:
+	// If the first operand was not 1000, MovD branches and leaves the
+	// flag in Nop: exactly one 1000 has been seen.
+	// If it was already Nop, this is the second 1000.  In that case the
+	// low three digits are 000, so print the leading 2 immediately and
+	// reuse the normal three-digit printer.  The trailing newline input
+	// need not be consumed because the program halts after printing.
+	ANY_DIGIT_HAS_BEEN_PRINTED_FLAG n2_only_1000
+	ROT '2'<<1 R_ROT OUT ?- R_OUT
+	R_ANY_DIGIT_HAS_BEEN_PRINTED_FLAG
+	MOVED print_result
+
+n2_only_1000:
 	MOVED clear_n2_msd
 
 
@@ -710,6 +738,17 @@
 
 add_n2_digit2_to_n1_digit2_fin:
 	R_OVERFLOW
+	// If exactly one input was 1000, ANY... is Nop.  Probe it here:
+	// Nop falls through to print_leading_one and changes back to MovD.
+	// With no 1000 it is MovD, so branch to the ordinary overflow path.
+	ANY_DIGIT_HAS_BEEN_PRINTED_FLAG no_input_1000
+	MOVED print_leading_one
+
+no_input_1000:
+	// The probe above changed MovD to Nop; restore it before the normal
+	// output routine so leading-zero suppression keeps its original state.
+	ANY_DIGIT_HAS_BEEN_PRINTED_FLAG no_input_1000_restored
+no_input_1000_restored:
 	OVERFLOW print_leading_one
 	MOVED print_result
 
