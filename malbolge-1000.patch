 // shift digit...
 append_tmp_digit_to_first_number:
 	R_WAITING_FOR_FIRST_NUMBER_FLAG
+	DIGIT_COUNT n1_fourth_digit
+	MOVED clear_n1_msd
+
+n1_fourth_digit:
+	// Mark operand 1 == 1000 by toggling ANY... from MovD to Nop.
