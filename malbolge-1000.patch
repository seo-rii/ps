@@ -163,6 +163,12 @@
 	Nop/Nop/Nop/MovD
 	Jmp
 
+// Count digits of the current operand; the fourth digit branches.
+// The same counter is reset at the separator and reused for operand 2.
+DIGIT_COUNT:
+	Nop/Nop/Nop/MovD
+	Jmp
+
 LOOP2_special:
 	Nop/MovD
 	Jmp
@@ -546,10 +552,37 @@
 
 read_first_number:
 	R_NUMBER_READ_FLAG
+reset_digit_count:
+	DIGIT_COUNT digit_count_reset
+	MOVED reset_digit_count
+digit_count_reset:
 	NUMBER_READ_FLAG restore_initial_state
 
 read_second_number:
-	// ADD NUMBERS AND PRINT RESULT
+	// PRINT_ZERO_FLAG is untouched during input.  If both operands were
+	// 1000, n2_fourth_digit advanced it once from MovD to Nop.
+	PRINT_ZERO_FLAG not_both_thousands
+both_thousands:
+	ROT '2'<<1 R_ROT OUT ?- R_OUT
+	R_ANY_DIGIT_HAS_BEEN_PRINTED_FLAG
+	MOVED print_result
+
+not_both_thousands:
+	// ANY_DIGIT_HAS_BEEN_PRINTED_FLAG is toggled for every operand that
